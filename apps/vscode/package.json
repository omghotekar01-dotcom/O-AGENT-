{
  "name": "oagent-vscode-companion",
  "displayName": "O-AGENT Workspace Companion",
  "description": "Connect your local O-AGENT Windows setup and manage trusted project files through a visible VS Code workspace sidebar",
  "version": "0.5.0",
  "publisher": "oagent-local",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./src/extension.cjs",
  "activationEvents": [
    "onCommand:oagent.configure",
    "onCommand:oagent.start",
    "onCommand:oagent.stop",
    "onCommand:oagent.enableMobileEdits",
    "onCommand:oagent.connectLocal",
    "onView:oagent.workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "oagent.connectLocal",
        "title": "O-AGENT: Connect from This Windows Laptop (No Key Paste)"
      },
      {
        "command": "oagent.configure",
        "title": "O-AGENT: Configure Secure Companion"
      },
      {
        "command": "oagent.start",
        "title": "O-AGENT: Start Remote Workspace Companion"
      },
      {
        "command": "oagent.stop",
        "title": "O-AGENT: Stop Remote Workspace Companion"
      },
      {
        "command": "oagent.enableMobileEdits",
        "title": "O-AGENT: Enable Mobile File Editing (30 minutes)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oagentWorkspace",
          "title": "O-AGENT",
          "icon": "resources/oagent.svg"
        }
      ]
    },
    "views": {
      "oagentWorkspace": [
        {
          "id": "oagent.workspace",
          "name": "Connected workspace",
          "type": "tree",
          "visibility": "visible"
        }
      ]
    }
  },
  "categories": [
    "Other"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test ../../tests/vscode-companion.test.mjs"
  }
}
