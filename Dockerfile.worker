FROM node:22-bookworm-slim
ENV NODE_ENV=production HOME=/home/node OAGENT_WORKSPACE_ROOT=/workspaces
WORKDIR /srv/oagent
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY apps/gateway ./apps/gateway
RUN mkdir -p /workspaces /home/node/.claude /home/node/.copilot \
  && chown -R node:node /srv/oagent /workspaces /home/node
USER node
CMD ["node", "apps/gateway/src/worker.mjs"]
