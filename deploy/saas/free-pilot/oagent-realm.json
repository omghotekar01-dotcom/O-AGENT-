{
  "realm": "oagent",
  "enabled": true,
  "displayName": "O-AGENT Private Pilot",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 900,
  "clientScopes": [
    {
      "name": "basic",
      "description": "Signed stable OIDC subject for tenant isolation",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "Subject (sub)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "oagent-read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "oagent-operate",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "oagent-web",
      "name": "Private O-AGENT web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "${OAGENT_ORIGIN}",
      "baseUrl": "${OAGENT_ORIGIN}/",
      "redirectUris": [
        "${OAGENT_ORIGIN}/"
      ],
      "webOrigins": [
        "${OAGENT_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${OAGENT_ORIGIN}/"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins",
        "oagent-read",
        "oagent-operate"
      ],
      "protocolMappers": [
        {
          "name": "O-AGENT resource audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "oagent-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "pilot-owner",
      "enabled": true,
      "emailVerified": false,
      "credentials": [
        {
          "type": "password",
          "value": "${OAGENT_OWNER_PASSWORD}",
          "temporary": true
        }
      ],
      "email": "pilot-owner@oagent.invalid",
      "firstName": "O-AGENT",
      "lastName": "Owner"
    }
  ],
  "defaultDefaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins",
    "oagent-read",
    "oagent-operate"
  ]
}
