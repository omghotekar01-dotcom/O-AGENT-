# EXACTLY ONE isolated tenant. Provider login and key never shared with API/other tenants.
OAGENT_SAAS_ORIGIN=https://agents.example.com
OAGENT_WORKSPACE_ROOT=/workspace
OAGENT_DEVICE_STORE=/home/oagent/.oagent-cloud/device.json
OAGENT_ENABLE_CLAUDE_AGENT_SDK=0
OAGENT_ENABLE_COPILOT_SDK=0
OAGENT_ENABLE_CODEX_LOCAL_SYNC=0
OAGENT_ALLOW_SHELL_TOOLS=0
