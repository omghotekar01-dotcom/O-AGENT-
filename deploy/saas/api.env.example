# SECRET MANAGER ONLY. Never commit actual credentials or production values.
NODE_ENV=production
HOST=0.0.0.0
PORT=8790
OAGENT_SAAS_ORIGIN=https://agents.example.com
DATABASE_URL=postgresql://oagent_runtime:REPLACE@db.example.com/oagent?sslmode=verify-full
OAGENT_OIDC_ISSUER=https://identity.example.com/
OAGENT_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OAGENT_OIDC_AUDIENCE=https://agents.example.com
OAGENT_OIDC_CLIENT_IDS=web-oidc-client,mcp-oidc-client,mobile-oidc-client
OAGENT_OIDC_WEB_CLIENT_ID=web-oidc-client
OAGENT_OIDC_AUTHORIZE_URL=https://identity.example.com/authorize
OAGENT_OIDC_TOKEN_URL=https://identity.example.com/oauth/token
# Migration identity exists only in one-off jobs (never API runtime).
# OAGENT_MIGRATION_DATABASE_URL=postgresql://oagent_migrator:REPLACE@db.example.com/oagent?sslmode=verify-full
