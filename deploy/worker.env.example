# Copy to .env.worker on your trusted cloud host (chmod 600).
# This file is injected into the SDK worker ONLY.
# Never copy the owner operator token, vault key, FCM service account or
# public email-delivery secrets into the worker's environment.
OAGENT_WORKER_TOKEN=replace-with-matching-server-worker-token
OAGENT_ENABLE_CLAUDE_AGENT_SDK=0
OAGENT_ENABLE_COPILOT_SDK=0
# Shell requires an extra explicit opt-in and exact owner approval.
# Keep off until the worker is isolated inside a restricted container.
OAGENT_ALLOW_SHELL_TOOLS=0
