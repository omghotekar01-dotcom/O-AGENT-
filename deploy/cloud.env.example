# COPY TO .env.cloud ON YOUR HOST. NEVER COMMIT REAL VALUES.
OAGENT_DOMAIN=agents.example.com
OAGENT_PUBLIC_URL=https://agents.example.com

# Distinct secrets; at least 32 random characters each.
OAGENT_API_TOKEN=replace-with-unique-64-char-secret
OAGENT_WORKER_TOKEN=replace-with-another-unique-64-char-secret
# 32 random bytes, base64 encoded, persisted securely in a secret manager.
OAGENT_VAULT_KEY_BASE64=replace-with-random-32-byte-base64-value

# Public accounts only after email is configured.
OAGENT_PUBLIC_ACCOUNTS=0
OAGENT_RESEND_API_KEY=
OAGENT_MAIL_FROM=

# Independent hosted SDK worker; enable only after real sign-in.
OAGENT_ENABLE_CLAUDE_AGENT_SDK=0
OAGENT_ENABLE_COPILOT_SDK=0
