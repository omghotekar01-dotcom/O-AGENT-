# Development only. Generate distinct random tokens; never commit actual values.
OAGENT_API_TOKEN=replace-with-a-long-random-operator-token
OAGENT_WORKER_TOKEN=replace-with-a-different-long-worker-token
HOST=127.0.0.1
PORT=8787
OAGENT_SERVER_URL=http://127.0.0.1:8787
OAGENT_WORKER_ID=local-worker
OAGENT_WORKSPACE_ROOT=.
OAGENT_DATA_FILE=./.local/oagent-data.json

# AI provider (configure on the BACKEND, not in Flutter; choose one)
OAGENT_AI_PROVIDER=openai
OAGENT_AI_MODEL=gpt-5.6-terra
# OPENAI_API_KEY=your-real-server-only-openai-api-key
# For Anthropic instead:
# OAGENT_AI_PROVIDER=anthropic
# OAGENT_AI_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=your-real-server-only-anthropic-api-key

# External project discovery (public GitHub repos need no token)
OAGENT_GITHUB_REPOS=omghotekar01-dotcom/O-AGENT-
# For private repos: fine-grained read-only token stored server-side
# OAGENT_GITHUB_TOKEN=your-private-server-only-token

# Opt-in user-authenticated Codex Cloud CLI task listing AND approved NEW task requests.
# Requires codex CLI installed/signed in on laptop and same setting on backend.
OAGENT_ENABLE_CODEX_CLOUD_SYNC=0

# Explicit opt-in only: save local Codex CLI/IDE session titles and project
# working-directory paths in the authenticated O-AGENT project hub.
OAGENT_ENABLE_CODEX_LOCAL_SYNC=0

# Optional Gemini API (separate account, only when OAGENT_AI_PROVIDER=gemini)
# GEMINI_API_KEY=your-server-only-google-ai-studio-key

# Required for mobile BYOK on manually hosted Node backends.
# Generate 32 cryptographically random bytes, encode base64, inject through
# your host's SECRET MANAGER. Never commit the value or reuse worker tokens.
# The O-AGENT.cmd Windows launcher creates/stores this securely via DPAPI.
# OAGENT_VAULT_KEY_BASE64=<base64-encoded-32-random-byte-key>

# OPTIONAL public self-service accounts: only enable on a persistent HTTPS backend.
OAGENT_PUBLIC_ACCOUNTS=0
# OAGENT_RESEND_API_KEY=<server-side Resend API key>
# OAGENT_MAIL_FROM=<verified-sender@example.org>
# OAGENT_PUBLIC_URL=https://your-backend.example.org
